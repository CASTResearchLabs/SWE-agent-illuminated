#!/usr/bin/env python3

import sys
import json
from pathlib import Path
from argparse import ArgumentParser

# Add lib directory to path
lib_path = str(Path(__file__).resolve().parent.parent / "lib")
sys.path.insert(0, lib_path)

from mcp_client import get_mcp_client, format_mcp_response, MCPError


def main():
    parser = ArgumentParser(description="Call a tool on the MCP server")
    parser.add_argument("tool_name", help="Name of the tool to call")
    parser.add_argument("arguments", nargs="?", help="JSON string of arguments")
    parser.add_argument("server_name", nargs="?", help="Name of MCP server (defaults to default server)")
    args = parser.parse_args()
    
    try:
        # Parse arguments if provided
        tool_args = {}
        if args.arguments:
            try:
                tool_args = json.loads(args.arguments)
            except json.JSONDecodeError as e:
                print(f"Error: Invalid JSON arguments: {e}")
                sys.exit(1)
        
        with get_mcp_client(server_name=args.server_name) as client:
            # Check server connectivity
            if not client.ping():
                server_name = args.server_name or "default"
                print(f"Error: Cannot reach MCP server '{server_name}' at {client.base_url}")
                sys.exit(1)
            
            # Call the tool
            response = client.call_tool(args.tool_name, tool_args)
            output = format_mcp_response(response)
            print(output)
            
    except MCPError as e:
        print(f"MCP Error: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"Unexpected error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()