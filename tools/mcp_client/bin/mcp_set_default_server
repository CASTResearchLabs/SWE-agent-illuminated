#!/usr/bin/env python3

import sys
from pathlib import Path
from argparse import ArgumentParser

# Add lib directory to path
lib_path = str(Path(__file__).resolve().parent.parent / "lib")
sys.path.insert(0, lib_path)

from mcp_client import list_available_servers
from registry import registry


def main():
    parser = ArgumentParser(description="Set the default MCP server")
    parser.add_argument("server_name", help="Name of the server to set as default")
    args = parser.parse_args()
    
    try:
        # Check if server exists
        servers = list_available_servers()
        
        if args.server_name not in servers:
            print(f"Error: Server '{args.server_name}' not found.")
            print("Available servers:")
            for name in servers.keys():
                print(f"  {name}")
            sys.exit(1)
            
        # Set as default
        registry["MCP_DEFAULT_SERVER"] = args.server_name
        
        print(f"✓ Set '{args.server_name}' as the default MCP server")
        
        # Show server details
        config = servers[args.server_name]
        print(f"  URL: {config.get('httpUrl', 'N/A')}")
        print(f"  Timeout: {config.get('timeout', 30000)}ms")
        
    except Exception as e:
        print(f"Error setting default server: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()