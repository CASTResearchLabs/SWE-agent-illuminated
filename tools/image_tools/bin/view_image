#!/usr/bin/env python3
# view_image – view an image file as a base64-encoded markdown image
import base64
import mimetypes
import pathlib
import sys

VALID_MIME_TYPES = {
    "image/png",
    "image/jpeg",
    "image/webp",
}

def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {pathlib.Path(sys.argv[0]).name} <image-file>")
        return 1

    img_path = pathlib.Path(sys.argv[1])

    if not img_path.exists():
        print(f"Error: File '{img_path}' does not exist")
        return 1

    if not img_path.is_file():
        print(f"Error: '{img_path}' is not a file")
        return 1

    try:
        mime = mimetypes.guess_type(img_path.name)[0]
        if mime not in VALID_MIME_TYPES:
            print(f"Error: Unsupported image type: {mime}. Valid types are: {', '.join(VALID_MIME_TYPES)}")
            return 1

        # read the file, base64-encode, and convert bytes → str
        b64 = base64.b64encode(img_path.read_bytes()).decode("ascii")

        # write the exact markdown snippet to stdout
        print(f"![{img_path.as_posix()}](data:{mime};base64,{b64})")
        return 0
    except Exception as e:
        print(f"Error processing image: {e}")
        return 1

if __name__ == "__main__":
    exit_code = main()
    if exit_code != 0:
        print(f"Command failed with exit code {exit_code}")
        # Don't call sys.exit() to avoid crashing shell
